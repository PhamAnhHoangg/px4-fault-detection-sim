<?xml version="1.0" encoding="UTF-8"?>
<!-- PX4's rc_cessna, unchanged, plus a chase camera rigidly attached behind it, for demo videos.
     The camera link has almost no mass (1e-5 kg) and no collision, so it does not change how the plane flies.
     Image topic: /chase_cam (640x480, 15 Hz). Record it with scripts/vision/record_frames.py (topic option set to /chase_cam) -->
<sdf version="1.9">
  <model name="rc_cessna_chase">
    <include merge="true">
      <uri>model://rc_cessna</uri>
    </include>
    <link name="chase_cam_link">
      <!-- 5 m behind, 1.5 m above, tilted down 0.29 rad so the plane sits in the middle of the image -->
      <pose>-5 0 1.5 0 0.29 0</pose>
      <inertial>
        <mass>0.00001</mass>
        <inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="chase_cam" type="camera">
        <topic>chase_cam</topic>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>3000</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="chase_cam_joint" type="fixed">
      <parent>base_link</parent>
      <child>chase_cam_link</child>
    </joint>
  </model>
</sdf>
