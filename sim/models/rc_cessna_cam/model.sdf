<?xml version="1.0" encoding="UTF-8"?>
<!-- PX4's rc_cessna, unchanged, plus one forward camera on the nose. Same pattern as PX4's x500_mono_cam.
     Image topic: /cessna_cam (320x240, 15 Hz). Camera looks along the plane's +x axis (forward), level with the body. -->
<sdf version="1.9">
  <model name="rc_cessna_cam">
    <include merge="true">
      <uri>model://rc_cessna</uri>
    </include>
    <link name="fwd_cam_link">
      <pose>0.30 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="fwd_cam" type="camera">
        <topic>cessna_cam</topic>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.40</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>3000</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="fwd_cam_joint" type="fixed">
      <parent>base_link</parent>
      <child>fwd_cam_link</child>
    </joint>
  </model>
</sdf>
